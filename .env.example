# ─── Database ────────────────────────────────────────────────────────────────
# Local (docker compose up -d db):
DATABASE_URL="postgresql://maturityflow:maturityflow@localhost:5432/maturityflow"
# Managed Postgres (Supabase / Neon / RDS) — the ONLY line that changes for cloud:
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
SESSION_SECRET="CHANGE-ME-generate-with-openssl-rand-base64-48-minimum-32-chars"
SESSION_TTL_HOURS=12

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"
STORAGE_ROOT="./storage"
DB_POOL_MAX=10

# Session cookies are marked Secure when APP_URL is https. A branch server reached over
# plain HTTP on the LAN must set this to false, or sign-in silently fails.
# COOKIE_SECURE=false
